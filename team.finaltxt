 <!-- Gallery Wrapper -->
    <div class="gallery-area" id="galleryArea">

        <!-- 50 Employee Grid -->
        <div class="employee-grid" id="employeeGrid"></div>

        <!-- Popup only inside gallery -->
        <div class="popup-overlay" id="popup">

            <div class="popup-card">

                <img id="popupImage">

                <div class="popup-content">

                    <h2 id="popupName"></h2>

                    <h3 id="popupPosition"></h3>

                    <p id="popupQuote"></p>

                </div>

            </div>

        </div>

    </div>




//TEAM
const employees = [];


for(let i=1;i<=50;i++){

    employees.push({

        name:`Employee ${i}`,

        position:"EGX Supply Chain",

        quote:
        "Serving Values. Connecting businesses through reliable logistics solutions.",

        image:`../images/AboutUs/Employee/E${i}.webp`

    });

}


const grid = document.getElementById("employeeGrid");


employees.forEach(emp=>{


    const card=document.createElement("div");

    card.className="employee-card";


    card.innerHTML=`

        <img src="${emp.image}">

        <div class="employee-info">

            <h4>${emp.name}</h4>

            <span>${emp.position}</span>

        </div>

    `;


    card.onclick=()=>openPopup(emp);


    grid.appendChild(card);

});



const popup=document.getElementById("popup");



function openPopup(emp){


    document.getElementById("popupImage").src =
        emp.image;


    document.getElementById("popupName").innerText =
        emp.name;


    document.getElementById("popupPosition").innerText =
        emp.position;


    document.getElementById("popupQuote").innerText =
        emp.quote;


    popup.classList.add("show");


    grid.classList.add("blur");

}



/* click dark area to close */

popup.addEventListener("click",function(e){


    if(e.target===popup){


        popup.classList.remove("show");


        grid.classList.remove("blur");

    }


});








/*TEAM SECOND FINAL*/
@import url('https://fonts.googleapis.com/css2?family=Italiana&family=DM+Sans:wght@300;400;600&display=swap');


*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}


body{
    background:#050505;
    color:white;
    font-family:"DM Sans",sans-serif;
}


/* SECTION */

.people-section{

    width:100%;
    padding:60px 0;
}


/* HEADER */

.section-header{

    text-align:center;
    margin-bottom:40px;

}


.section-header h1{

    font-family:"Italiana";
    font-size:70px;
    color:#FFD600;
    letter-spacing:4px;

}


.section-header p{

    color:#aaa;
    margin-top:10px;

}


/* GALLERY AREA */

.gallery-area{

    position:relative;
    width:100%;
    overflow:hidden;

}


/* GRID */

.employee-grid{

    width:100%;

    display:grid;

    grid-template-columns: repeat(10, 1fr);

    gap:10px;

    padding:0 10px;

    transition:0.5s ease;

}


/* Blur only gallery */

.employee-grid.blur{

    filter:blur(8px);

    transform:scale(.98);

}



/* CARD */

.employee-card{

    position:relative;

    aspect-ratio: 3 / 4;

    overflow:hidden;

    cursor:pointer;

    border-radius:10px;

    border:1px solid rgba(255,255,255,.08);

    transition:.4s;

}


.employee-card:hover{

    border-color:#FFD600;

    box-shadow:0 0 25px rgba(255,214,0,.5);

}


.employee-card img{

    width:100%;

    height:100%;

    object-fit:cover;

    transition:.6s;

}


.employee-card:hover img{

    transform:scale(1.1);

}


/* INFO ON HOVER */

.employee-info{

    position:absolute;

    left:0;
    right:0;
    bottom:0;

    padding:15px;

    background:linear-gradient(
        transparent,
        rgba(0,0,0,.95)
    );

    transform:translateY(100%);

    transition:.4s;

}


.employee-card:hover .employee-info{

    transform:translateY(0);

}


.employee-info h4{

    color:#FFD600;

}


.employee-info span{

    color:#ddd;

    font-size:13px;

}



/* POPUP INSIDE SECTION */

.popup-overlay{

    position:absolute;

    inset:0;

    background:rgba(0,0,0,.55);

    display:flex;

    justify-content:center;

    align-items:center;


    opacity:0;

    visibility:hidden;

    transition:.4s;

    z-index:20;

}


.popup-overlay.show{

    opacity:1;

    visibility:visible;

}



/* CARD */

.popup-card{

    width:420px;

    background:#111;

    border:1px solid #FFD600;

    border-radius:20px;

    overflow:hidden;

    box-shadow:
    0 0 60px rgba(255,214,0,.4);


    transform:scale(.75);

    transition:.4s;

}


.popup-overlay.show .popup-card{

    transform:scale(1);

}


.popup-card img{

    width:100%;

    height:450px;

    object-fit:cover;

}


.popup-content{

    padding:25px;

}


.popup-content h2{

    font-family:"Italiana";

    font-size:40px;

    color:#FFD600;

}


.popup-content h3{

    margin-top:5px;

    font-weight:400;

}


.popup-content p{

    margin-top:15px;

    color:#aaa;

    line-height:1.6;

}



/* RESPONSIVE */


@media(max-width:1200px){

    .employee-grid{

        grid-template-columns:repeat(5,1fr);

    }

}


@media(max-width:768px){

    .employee-grid{

        grid-template-columns:repeat(3,1fr);

    }


    .section-header h1{

        font-size:45px;

    }


    .popup-card{

        width:90%;

    }

}
